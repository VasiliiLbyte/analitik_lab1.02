BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_PROXY=
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite+aiosqlite:///bot.db

GIGACHAT_CLIENT_ID=your_gigachat_client_id
GIGACHAT_CLIENT_SECRET=your_gigachat_client_secret
GIGACHAT_SCOPE=GIGACHAT_API_PERS
DADATA_API_KEY=your_dadata_api_key
DADATA_SECRET_KEY=your_dadata_secret_key
DADATA_ENABLED=true
DADATA_TIMEOUT_SEC=5.0
APP_VERSION=dev
RUNTIME_LOCK_ENABLED=true
RUNTIME_LOCK_PATH=/tmp/analitik_lab_bot.lock
ADMIN_USER_IDS=

LOG_LEVEL=INFO
NDS_RATE=5.0
PROTOCOL_FEE_RATE=3.0

# Bitrix24 (смарт-процесс "Лабораторное исследование")
# Полный URL вебхука, заканчивающийся на `/` (после "ПЕРЕГЕНЕРИРОВАТЬ" в Bitrix24)
BITRIX_WEBHOOK_URL=
BITRIX_ENTITY_TYPE_ID=1062
BITRIX_CATEGORY_ID=0
BITRIX_INITIAL_STAGE=NEW
BITRIX_ASSIGNED_ID=27
BITRIX_OBSERVERS=8,14,17,21,26
# Код пользовательского поля ИНН у компании (если нет — оставьте пустым и будет только TITLE)
BITRIX_COMPANY_INN_UF=UF_CRM_INN
